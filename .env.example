# Copy this file to .env.local and fill in real values from your Supabase
# project's Settings -> API page. Never commit .env.local (it's gitignored).
#
# VITE_SUPABASE_ANON_KEY is safe to expose client-side by design - Row
# Level Security policies on the database tables are the actual security
# boundary, not secrecy of this key. Never use the service_role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
